# Copia este archivo a .env.local y completa lo que necesites. Las dos son opcionales.

# Link que codifica el QR y abre el botón "Canjear ahora" de /creditos/con-cuenta. Sin él, ese flujo muestra un aviso de que no hay evento en curso. /creditos/sin-cuenta no lo usa: tiene su propio link fijo.
CREDITS_CLAIM_URL=

# Link del evento en Luma. Sin él, no se muestra el logo de Luma en las páginas de créditos.
LUMA_EVENT_URL=
